# =====================================================================
# ExamAI — Flutter App Environment Variables
# =====================================================================
# Copy this file to lib/assets/.env and fill in your own values.
# ⚠️  NEVER commit lib/assets/.env to version control.
# =====================================================================

# Supabase Project URL
# Found in: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous (Public) Key
# Found in: Supabase Dashboard → Project Settings → API → anon public key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Gemini API Key (used for AI grading)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
